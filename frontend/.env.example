# Copy to .env for local development. Real values are set on the
# hosting platform (Vercel) as environment variables -- never here.
#
# Leave VITE_API_URL EMPTY to use the Vite dev-server proxy in
# vite.config.js (which forwards /api to a local API on port 5000).
# Set it to a full origin to call a deployed API directly.
VITE_API_URL=
